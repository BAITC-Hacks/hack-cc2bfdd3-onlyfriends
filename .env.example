# Example local configuration. Copy to .env and fill in your own values.
# Current Python modules do not load .env automatically; pass these settings
# to their function arguments until the planned CLI is implemented.

# Optional future LLM integration. The current forecast agent does not use it.
OPENAI_API_KEY=

# Optional LangSmith tracing. Agent inputs, outputs and metadata are redacted.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=windpower-forecast

# Open-Meteo Single Runs is currently called without an API token.

# Local input files: one SCADA CSV per turbine.
TURBINE_1_CSV=
TURBINE_2_CSV=
SOURCE_TIMEZONE=Asia/Almaty

# Local weather cache and forecast artifacts.
WEATHER_CACHE_DIR=raw/weather
FORECAST_OUTPUT_DIR=artifacts/forecasts
