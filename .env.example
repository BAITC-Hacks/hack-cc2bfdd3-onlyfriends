# Example local configuration. Copy to .env and fill in your own values.
# The forecast Q&A API reads OPENAI_API_KEY from this file (or the environment).

# Used only for natural-language questions about saved forecasts; the power model does not use OpenAI.
OPENAI_API_KEY=
WINDPOWER_ASSISTANT_MODEL=gpt-5.6-luna

# Optional LangSmith tracing. Agent inputs, outputs and metadata are redacted.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=windpower-forecast

# Open-Meteo Single Runs is currently called without an API token.

# Local input files: one SCADA CSV per turbine.
TURBINE_1_CSV=
TURBINE_2_CSV=
SOURCE_TIMEZONE=Asia/Almaty

# Local weather cache and forecast artifacts.
WEATHER_CACHE_DIR=raw/weather
FORECAST_OUTPUT_DIR=artifacts/forecasts

# Dashboard API; defaults shown below. Only load trusted local joblib bundles.
WINDPOWER_MODEL_PATH=artifacts/model/model.joblib
WINDPOWER_CACHE_DIR=artifacts/weather
WINDPOWER_OUTPUT_DIR=artifacts/dashboard_runs
WINDPOWER_API_HOST=127.0.0.1
WINDPOWER_API_PORT=8000
